{
  "name": "voice-memory-local",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:boundaries": "node --test server.test.mjs voice-adapter.test.mjs synthesis.test.mjs provider.test.mjs retrieval-bridge.test.mjs fictional-sample.test.mjs cache.test.mjs motion.test.mjs",
    "test:browser": "node browser-check.mjs && node notes-check.mjs",
    "format:check": "prettier --check *.mjs *.ts *.json public/*",
    "verify": "npm run format:check && npm run typecheck && npm run build && npm test && npm run test:boundaries && npm run test:evaluation && npm run test:ingest && npm run test:clinical && npm run bench:ingest && npm run bench:retrieval && npm run test:browser",
    "test:evaluation": "node --test evaluation/*.test.mjs",
    "test:ingest": "node --test --test-concurrency=1 ingest/*.test.mjs",
    "bench:ingest": "node ingest/bench.mjs",
    "fixtures:build": "node ingest/fixtures/build.mjs && python3 ingest/fixtures/degrade.py",
    "test:clinical": "node --test --test-concurrency=1 clinical/*.test.mjs",
    "bench:retrieval": "node evaluation/retrieval-bench.mjs",
    "fixtures:clinical": "node clinical/fixtures/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@tesseract.js-data/eng": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "5.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "pdf-lib": "1.17.1",
    "playwright": "1.62.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
