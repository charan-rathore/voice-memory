diff --git a/src/requested-fact.ts b/src/requested-fact.ts
new file mode 100644
index 0000000..92dbb03
--- /dev/null
+++ b/src/requested-fact.ts
@@ -0,0 +1,198 @@
+// Bounded, local requested-relation lookup. Topic overlap cannot stand in for
+// a requested actor/date, report cadence, or finance decision. No values are
+// supplied by the query: only complete verbatim source assertions can answer.
+type Kind = "requested-date" | "report-cadence" | "finance-decision";
+type Source = { id: string; title: string; text: string; hash: string };
+const date =
+  /\b(?:\d{1,2}\s+(?:January|February|March|April|May|June|July|August|September|October|November|December)(?:\s+\d{4})?|\d{4}-\d{2}-\d{2})\b/i;
+const cadence =
+  /\b(?:daily|weekly|biweekly|fortnightly|monthly|quarterly|annually|every\s+\d+\s+(?:days?|weeks?|months?))\b/i;
+const report = /\b(?:(?:progress|status)\s+)?report(?:s|ed|ing)?\b/i;
+const finance = /\b(?:finance|financial|accountants?)\b/i;
+const decision = /\b(?:approv(?:al|ed)|sign[- ]?off|signed off)\b/i;
+const polar = /^\s*(?:is|are|was|were|has|have|had|did|does|do)\b/i;
+const stop = new Set(
+  "what which when how often frequency cadence is are was were has have had does do did the a an to of for by from in on with been be being it its this that our my their side s want wants wanted keep retain request requested asks ask client clients customer customers progress status report reports reported reporting deadline due date finance financial money commercial accountant accountants approval approved sign signed off sign-off signoff".split(
+    " ",
+  ),
+);
+function tokens(s: string): string[] {
+  return s.toLowerCase().match(/[a-z0-9]+(?:[-_][a-z0-9]+)*/g) ?? [];
+}
+function request(q: string): Kind | null {
+  // Multi-part, negative, temporal and instruction questions stay with the
+  // established policies. This route does not resolve history or mutations.
+  if (
+    /\b(?:and|or|not|never|except|without|before|after|as of|why|who|when|mark|update|change)\b|n['’]t\b/i.test(
+      q,
+    )
+  )
+    return null;
+  if (
+    /\b(?:deadline|due date)\b/i.test(q) &&
+    /\b(?:want|wants|keep|retain|request|requested|asks)\b/i.test(q) &&
+    /\b(?:client|customer)\b/i.test(q)
+  )
+    return "requested-date";
+  if (/\b(?:how often|frequency|cadence)\b/i.test(q) && report.test(q))
+    return "report-cadence";
+  if (
+    polar.test(q) &&
+    /\b(?:money|commercial|finance|financial|accountants?)\b/i.test(q) &&
+    decision.test(q)
+  )
+    return "finance-decision";
+  return null;
+}
+export function requestedFactSupport(question: string, sources: Source[]) {
+  const kind = request(question);
+  if (!kind) return null;
+  // Unknown nouns/modifiers/names must bind literally in the assertion, not
+  // in another document or a neighboring record. Never drop them as stopwords.
+  const qualifiers = tokens(question).filter((t) => !stop.has(t));
+  const actor = /\bcustomer\b/i.test(question)
+    ? /\bcustomer\b/i
+    : /\bclient\b/i;
+  const candidates: Array<{
+    source: Source;
+    start: number;
+    end: number;
+    quote: string;
+    priority: number;
+    values: string[];
+  }> = [];
+  // Explicit cost bounds, independent of retrieval top-k and dense residency.
+  // Over budget means no repair, never a partially scanned corpus verdict.
+  if (
+    sources.length > 16 ||
+    sources.reduce((n, s) => n + s.text.length, 0) > 500_000
+  )
+    return { kind, spans: [], ambiguous: false };
+  let overflow = false;
+  for (const source of sources) {
+    for (const line of source.text.matchAll(/[^\n]+/g)) {
+      if (/^\s*(?:#|Author:|Type:|Date:)/i.test(line[0])) continue;
+      // Preserve semicolon qualifiers ("confirmed; finance pending") and
+      // conditions in the same sentence. Exact offsets survive list furniture.
+      const text = line[0].replace(/^\s*(?:\d+\.\s+|[-*]\s+)?/, "");
+      const base = line.index! + line[0].length - text.length;
+      for (const m of text.matchAll(/[^.!?]+(?:[.!?]+(?=\s|$)|$)/g)) {
+        const quote = m[0].trim();
+        if (!quote) continue;
+        const words = new Set(tokens(quote));
+        if (qualifiers.some((t) => !words.has(t))) continue;
+        // Questions, examples and hypothetical assertions are not decisions.
+        if (
+          /\?|\b(?:example|template|would|could|might|if|assuming)\b/i.test(
+            quote,
+          )
+        )
+          continue;
+        let priority = 0;
+        let values: string[] = [];
+        if (kind === "requested-date") {
+          if (!date.test(quote) || !/\b(?:deadline|due date)\b/i.test(quote))
+            continue;
+          // Actor must govern a request, not merely occur in a date sentence.
+          const relation =
+            /\b(client|customer)\s+(?:asks?\s+to|wants?\s+to|requests?)\s+(?:retain|keep)\b/i.exec(
+              quote,
+            );
+          if (!relation || !actor.test(relation[1])) continue;
+          const boundDate = new RegExp(
+            `${date.source}\\s+(?:[a-z-]+\\s+){0,2}deadline|(?:deadline|due date)\\s*(?:(?:is|of|for)\\s+)?${date.source}`,
+            "gi",
+          );
+          values = [...quote.matchAll(boundDate)].map((m) =>
+            date.exec(m[0])![0].toLowerCase(),
+          );
+          if (!values.length) continue;
+        } else if (kind === "report-cadence") {
+          if (!report.test(quote) || !cadence.test(quote)) continue;
+          // Frequency must modify reporting, not a meeting/billing cadence in
+          // the same sentence. Keep the complete sentence, including status.
+          const relation = new RegExp(
+            `(?<before>${cadence.source})\\s+(?:progress\\s+|status\\s+)?report|report(?:s|ed|ing)?\\s+(?:is\\s+|occurs?\\s+)?(?<after>${cadence.source})`,
+            "gi",
+          );
+          values = [...quote.matchAll(relation)].map((m) =>
+            (m.groups!.before ?? m.groups!.after).toLowerCase(),
+          );
+          if (!values.length) continue;
+          // Decision-bearing support leads a mere proposal; neither is turned
+          // into an inferred CONFIRMED verdict by this extractive route.
+          priority = /\b(?:confirmed|agreed|approved)\b/i.test(quote) ? 1 : 0;
+        } else {
+          if (!finance.test(quote) || !decision.test(quote)) continue;
+          const party =
+            /\b(client|customer|supplier|vendor|internal)\s+(?:finance|financial|accountants?)\b/i.exec(
+              quote,
+            )?.[1];
+          if (
+            /\b(?:client|customer)\b/i.test(question) &&
+            party &&
+            !actor.test(party)
+          )
+            continue;
+          // Bind finance to its own approval/signoff. A draft fee, an unsigned
+          // agreement, or a different party's approval is not finance signoff.
+          const relation =
+            /\b(?:finance|financial|accountants?)\s+(?:approval\s+(?:[^.;]{0,85})?\b(?:pending|outstanding|approved|granted|not recorded)|(?:(?:had|has|have|not|yet|already|formally)\s+)*(?:signed off|approved)\b)/i.exec(
+              quote,
+            );
+          if (!relation) continue;
+          if (
+            /\b(?:money|commercial)\b/i.test(question) &&
+            !/\b(?:fee|payment|commercial|terms|budget|schedule)\b/i.test(quote)
+          )
+            continue;
+          values = [
+            /\b(?:not|no|pending|outstanding)\b/i.test(relation[0])
+              ? "not-established"
+              : "recorded",
+          ];
+          if (
+            /\b(?:propos\w*|draft|subject to|until|should|will|must)\b/i.test(
+              quote,
+            )
+          )
+            continue;
+          priority = /\bapproval\b/i.test(quote) ? 1 : 0;
+        }
+        if (quote.length > 450 || quote.split(/\s+/).length > 55) {
+          overflow = true;
+          continue;
+        }
+        const start = base + m.index! + m[0].length - m[0].trimStart().length;
+        candidates.push({
+          source,
+          start,
+          end: start + quote.length,
+          quote,
+          priority,
+          values,
+        });
+      }
+    }
+  }
+  // Keep differing statements, including changed/conflicting support. Do not
+  // use document recency as authority. Overflow refuses rather than truncates
+  // contrary evidence or expands the ordinary retrieval top-k.
+  const unique = [
+    ...new Map(candidates.map((c) => [c.quote.toLowerCase(), c])).values(),
+  ];
+  unique.sort(
+    (a, b) =>
+      b.priority - a.priority ||
+      a.source.title.localeCompare(b.source.title) ||
+      a.start - b.start,
+  );
+  if (
+    overflow ||
+    unique.length > 3 ||
+    unique.reduce((n, c) => n + c.quote.split(/\s+/).length, 0) > 110
+  )
+    return { kind, spans: [], ambiguous: false };
+  const values = new Set(unique.flatMap((c) => c.values));
+  return { kind, spans: unique, ambiguous: values.size > 1 };
+}
diff --git a/tests/requested-fact.test.mjs b/tests/requested-fact.test.mjs
new file mode 100644
index 0000000..caa6536
--- /dev/null
+++ b/tests/requested-fact.test.mjs
@@ -0,0 +1,277 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  capture,
+  corpus,
+  questions,
+} from "../evaluation/requested-fact/reproduce.mjs";
+
+const needed = [
+  "The client asks to retain the original 15 November deadline for the pilot.",
+  "Weekly reporting is confirmed",
+  "Finance approval for any revised fee or payment schedule remains pending",
+];
+test("public upload + HTTP ask + default HTTP SSE carry requested support, not only topical passages", async () => {
+  const rows = await capture(await corpus());
+  rows.forEach((row, i) => {
+    for (const text of [
+      row.typed.lead?.text,
+      row.typed.answer,
+      row.spokenTurn?.spoken,
+    ])
+      assert.ok(text?.includes(needed[i]), `${row.question}: ${text}`);
+    for (const citations of [
+      row.typed.lead?.citations,
+      row.typed.evidence,
+      row.spokenTurn?.citations,
+    ])
+      assert.ok(citations?.some((c) => c.quote.includes(needed[i])));
+    assert.equal(row.result.actualMode, "keyword");
+    if (i === 1)
+      assert.match(
+        row.result.evidence[0].quote,
+        /^Weekly reporting is confirmed/,
+      );
+  });
+});
+
+import {
+  answer,
+  draft,
+  importBundle,
+  answerFromRetrieval,
+  constrainRequestedEvidence,
+  retrieveFromRows,
+} from "../dist/engine.mjs";
+const bundleOf = (text) =>
+  importBundle([
+    { title: "Cedar.md", text: "# Cedar project records\n\n" + text },
+  ]);
+const facts = [
+  {
+    q: questions[0],
+    missing:
+      "The internal deadline is 3 March 2031. The client has not requested a deadline.",
+    changed:
+      "The client asks to keep the original 9 April 2032 deadline for the trial.",
+    want: /9 April 2032/,
+  },
+  {
+    q: questions[1],
+    missing:
+      "Weekly billing is confirmed. Progress reporting was discussed without a cadence.",
+    changed:
+      "Monthly progress reporting is confirmed; finance approval is pending.",
+    want: /Monthly progress reporting is confirmed/,
+  },
+  {
+    q: questions[2],
+    missing:
+      "The proposed fee is $700. The commercial proposal requires a countersignature. The supplier finance team approved its own budget.",
+    changed: "Client finance has signed off on the revised commercial terms.",
+    want: /Client finance has signed off/,
+  },
+];
+for (const f of facts) {
+  test(`missing-support control: ${f.q}`, () => {
+    const a = answer(f.q, bundleOf(f.missing));
+    assert.equal(a.refused, true);
+    assert.equal(a.evidence.length, 0);
+  });
+  test(`changed support is quoted, not a memorized answer: ${f.q}`, () => {
+    const b = bundleOf(f.changed),
+      a = answer(f.q, b);
+    assert.equal(a.refused, false);
+    assert.match(a.answer, f.want);
+    assert.doesNotMatch(
+      a.answer,
+      /15 November|22 November|Weekly|48,000|42,000/,
+    );
+    for (const e of a.evidence)
+      assert.equal(b.sources[0].text.slice(e.start, e.end), e.quote);
+  });
+}
+test("a proposed reporting cadence is never promoted to confirmed; changed and conflicting support is retained", () => {
+  const a = answer(
+    questions[1],
+    bundleOf("Weekly progress reporting is proposed, not agreed."),
+  );
+  assert.equal(a.supported, true);
+  assert.match(a.spoken, /proposed, not agreed/);
+  const b = answer(
+    questions[1],
+    bundleOf(
+      "Monthly progress reporting is confirmed. Weekly reporting is confirmed.",
+    ),
+  );
+  assert.equal(b.reviewEvidence.length, 2);
+  assert.equal(b.supported, false);
+  assert.equal(b.unresolved, true);
+  assert.match(b.spoken, /Monthly/);
+  assert.match(b.spoken, /Weekly/);
+});
+test("conditional, draft, wrong-role and wrong-owner finance support cannot become client signoff", () => {
+  for (const text of [
+    "Client finance would approve the terms if the audit passed.",
+    "Client finance approval is proposed, not recorded.",
+    "The client approved delivery. Supplier finance has signed off on its own terms.",
+    "Client finance approval remains pending for the renewal. The expansion fee is $900.",
+  ]) {
+    const q = text.includes("renewal")
+      ? "Has the expansion money side been signed off by the client's accountants?"
+      : questions[2];
+    assert.equal(answer(q, bundleOf(text)).refused, true, text);
+  }
+});
+test("unbound requested modifiers do not disappear; unrelated ordinary positives stay on their routes", () => {
+  const b = bundleOf(
+    "Weekly reporting is confirmed. The client asks to keep the original 9 April 2032 deadline. The Copper parking permit number is PP-204. Shipment SH-123: tracking number: ZZ-204.",
+  );
+  for (const q of [
+    "How often is security progress reported?",
+    "What deadline does the Violet client want to keep?",
+  ])
+    assert.equal(answer(q, b).refused, true);
+  const permit = answer("What is the Copper parking permit number?", b);
+  assert.equal(permit.requestedFact, false);
+  assert.match(permit.answer, /PP-204/);
+  const identifier = answer("What is the Violet parking permit number?", b);
+  assert.equal(identifier.refused, true);
+});
+test("support overflow and scan overflow refuse instead of silently losing contrary records", () => {
+  const a = answer(
+    questions[1],
+    bundleOf(
+      "Daily reporting is confirmed. Weekly reporting is confirmed. Monthly reporting is confirmed. Quarterly reporting is confirmed.",
+    ),
+  );
+  assert.equal(a.refused, true);
+  const b = importBundle(
+    Array.from({ length: 3 }, (_, i) => ({
+      title: `large${i}.md`,
+      text:
+        "Unrelated statement. ".repeat(10000) +
+        "Weekly reporting is confirmed.",
+    })),
+  );
+  assert.equal(answer(questions[1], b).refused, true);
+});
+test("external retrieval policy never promotes an insufficient pack from a source scan", () => {
+  const b = bundleOf("Weekly reporting is confirmed; the client asked for it."),
+    q = questions[1];
+  const found = retrieveFromRows({
+    query: q,
+    queryVector: null,
+    mode: "keyword",
+    topK: 3,
+    embeddingModel: null,
+    rows: b.rows,
+    storage: {
+      backend: "ephemeral",
+      durable: false,
+      denseAvailable: false,
+      warning: null,
+    },
+    corpusScope: { kind: "corpus", corpusId: b.scope },
+  });
+  const r = answerFromRetrieval(
+    q,
+    b,
+    { ...found, evidence: "insufficient" },
+    { actualMode: "keyword", embeddingModel: null },
+  );
+  assert.equal(constrainRequestedEvidence(q, b, r).refused, true);
+});
+test("public and default SSE controls preserve absence, proposal qualifiers, changed values and conflicting support", async () => {
+  const docs = [
+    {
+      title: "Cedar.md",
+      text: "# Cedar project records\n\nThe client asks to keep the original 9 April 2032 deadline for the trial. Monthly progress reporting is proposed, not confirmed. Client finance has signed off on the revised commercial terms.",
+    },
+  ];
+  const changed = await capture(docs);
+  changed.forEach((row, i) => {
+    for (const text of [
+      row.typed.lead.text,
+      row.typed.answer,
+      row.spokenTurn.spoken,
+    ])
+      assert.match(
+        text,
+        i === 1
+          ? /Monthly progress reporting is proposed, not confirmed/
+          : facts[i].want,
+      );
+    assert.equal(row.typed.lead.verdict, "QUOTED");
+  });
+  const absent = await capture([
+    {
+      title: "Cedar.md",
+      text: "# Cedar project records\n\nThere is an internal deadline of 3 March 2031. Weekly billing is confirmed. The proposed commercial fee is $700 and no agreement is signed.",
+    },
+  ]);
+  for (const row of absent) {
+    assert.equal(row.typed.lead?.verdict, "UNKNOWN");
+    assert.equal(row.spokenTurn.verdict, "UNKNOWN");
+    assert.equal(row.spokenTurn.citations.length, 0);
+    assert.equal(row.typed.evidence.length, 0);
+  }
+});
+
+test("opaque identifiers remain whole qualifiers, never prefixes of other records", () => {
+  const b = bundleOf(
+    "Weekly progress reporting is confirmed for record SH-8-A.",
+  );
+  assert.equal(
+    answer("How often is progress reported for record SH-8?", b).refused,
+    true,
+  );
+  assert.equal(
+    answer("How often is progress reported for record SH-8-A?", b).supported,
+    true,
+  );
+});
+test("an oversized contrary assertion refuses instead of disappearing from the evidence pack", () => {
+  const b = bundleOf(
+    "Weekly progress reporting is confirmed. Monthly progress reporting is confirmed " +
+      "with additional qualifications ".repeat(30) +
+      ".",
+  );
+  assert.equal(answer(questions[1], b).refused, true);
+});
+
+test("conflicting requested support cannot authorize a draft", () => {
+  for (const text of [
+    "Monthly progress reporting is confirmed. Weekly reporting is confirmed.",
+    "Client finance has signed off on the terms. Client finance has not yet signed off on the terms.",
+    "The client asks to retain the original 9 April 2032 deadline. The client asks to keep the original 10 April 2032 deadline.",
+  ]) {
+    const b = bundleOf(text),
+      q = text.includes("reporting")
+        ? questions[1]
+        : text.includes("finance")
+          ? questions[2]
+          : questions[0];
+    const a = answer(q, b);
+    assert.equal(a.unresolved, true);
+    assert.equal(a.evidenceStatus, "ambiguous");
+    assert.throws(() => draft(a, b));
+  }
+});
+
+test("HTTP and default SSE expose conflicting statements as ambiguous, never an approved current fact", async () => {
+  const rows = await capture([
+    {
+      title: "Cedar.md",
+      text: "# Cedar project records\n\nThe client asks to keep the original 9 April 2032 deadline. The client asks to retain the original 10 April 2032 deadline. Weekly reporting is confirmed. Monthly reporting is confirmed. Client finance has signed off on the terms. Client finance has not yet signed off on the terms.",
+    },
+  ]);
+  for (const row of rows) {
+    assert.equal(row.result.unresolved, true);
+    assert.equal(row.result.supported, false);
+    assert.equal(row.typed.lead.verdict, "AMBIGUOUS");
+    assert.equal(row.spokenTurn.verdict, "AMBIGUOUS");
+    assert.equal(row.typed.lead.citations.length, 2);
+    assert.match(row.spokenTurn.spoken, /Conflicting source statements/);
+  }
+});
