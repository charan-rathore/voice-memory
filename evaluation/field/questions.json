  "docs": {
    "HimanshuBh__chest-mri-without-contrast-sample-report-1.pdf": [
      {
        "q": "What does this report suggest?",
        "expect": "(?i)impression.*ground glass"
      },
      {
        "q": "Summarize this report",
        "expect": "(?i)impression.*hyperinflation"
      },
      {
        "q": "What did the scan find?",
        "expect": "(?i)findings.*thyroid gland is unremarkable"
      },
      { "q": "Why was this scan done?", "expect": "(?i)smoking.*cough" },
      { "q": "Was contrast used?", "expect": "(?i)contrast.*none" },
      { "q": "Is the heart enlarged?", "expect": "(?i)cardiomegaly" },
      { "q": "Any fluid around the lungs?", "expect": "(?i)effusion" },
      { "q": "Is there a hernia?", "expect": "(?i)hiatal hernia" },
      { "q": "Any fractures?", "expect": "(?i)compression fractures" },
      { "q": "Is the patient a smoker?", "expect": "(?i)smoking" },
      {
        "q": "Any problem with the spine?",
        "expect": "(?i)spondylosis|compression fractures"
      },
      { "q": "Are the lymph nodes swollen?", "expect": "(?i)adenopathy" },
      { "q": "Any kidney stones?", "expect": null },
      { "q": "Is there cancer?", "expect": null },
      { "q": "What medicines is the patient taking?", "expect": null }
    ],
    "HimanshuBh__KFT-test-report-format-example-sample-template-Drlogy-lab-report.pdf": [
      {
        "q": "What is my creatinine?",
        "expect": "(?i)creatinine.*1\\.5.*above"
      },
      { "q": "How are my kidneys?", "expect": "(?i)creatinine 1\\.5" },
      {
        "q": "Is anything abnormal?",
        "expect": "(?i)creatinine.*phosphorus|phosphorus.*creatinine"
      },
      {
        "q": "What is the phosphorus level?",
        "expect": "(?i)phosphorus.*1\\.4.*below"
      },
      { "q": "potassium?", "expect": "(?i)3\\.9" },
      { "q": "What is my TSH?", "expect": null },
      { "q": "mera urea kitna hai?", "expect": "(?i)urea.*15" }
    ],
    "HimanshuBh__THYROID-PROFILE-test-report-format-example-sample-template-Drlogy-lab-report.pdf": [
      { "q": "What is the TSH?", "expect": "(?i)10\\.10.*above" },
      { "q": "How is my thyroid?", "expect": "(?i)T3.*T4|TSH" },
      { "q": "Is my T4 high?", "expect": "(?i)13\\.60" },
      { "q": "What is my hemoglobin?", "expect": null }
    ],
    "lilbabycry__sample_cbc_drlogy.pdf": [
      { "q": "What is my hemoglobin?", "expect": "(?i)12\\.5.*below" },
