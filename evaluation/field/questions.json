      { "q": "platelets?", "expect": "(?i)150000" },
      {
        "q": "Anything outside the normal range?",
        "expect": "(?i)packed cell volume.*hemoglobin|hemoglobin.*packed cell volume"
      },
      { "q": "what is my cholesterol", "expect": null }
    ],
    "tkarim45__MR._ATTIQ.pdf": [
